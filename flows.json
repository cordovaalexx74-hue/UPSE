    {
        "id": "fn_dash_temp",
        "type": "function",
        "z": "tab_dash_upse",
        "name": "Simular temperatura",
        "func": "const temp = +(20 + Math.random() * 20).toFixed(1);\nmsg.lectura = {\n    sensor: \"DHT11-UPSE\",\n    temperatura: temp,\n    unidad: \"C\",\n    hora: new Date().toLocaleTimeString()\n};\nmsg.payload = temp;\nmsg.topic = \"Temperatura\";\nreturn msg;",
        "outputs": 1,
        "x": 360,
        "y": 220,
        "wires": [
            [
                "gauge_dash_temp",
                "chart_dash_temp",
                "sw_dash_umbral",
                "dbg_dash_lectura"
            ]
        ]
    },
