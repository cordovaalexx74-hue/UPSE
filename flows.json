    {
        "id": "fn_dash_cfg",
        "type": "function",
        "z": "tab_dash_upse",
        "name": "Configuracion del flujo",
        "func": "const VERSION = \"v3.0\";\nconst UMBRAL  = 25;   \n// ==============================================================\n\nflow.set(\"umbral\", UMBRAL);\nflow.set(\"version\", VERSION);\nmsg.payload = VERSION + \"  |  alerta si temperatura > \" + UMBRAL + \" °C\";\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 90,
        "wires": [
            [
                "txt_dash_version"
            ]
        ]
    },
