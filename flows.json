    {
        "id": "exec_dash_log",
        "type": "exec",
        "z": "tab_dash_upse",
        "command": "git -C \"C:/Users/ALEX CORDOVA/.node-red/projects/ProyectosGIT\" log -10 --pretty=format:%h~%an~%ar~%s",
        "addpay": "",
        "append": "",
        "useSpawn": "false",
        "timer": "10",
        "winHide": true,
        "oldrc": false,
        "name": "git log",
        "x": 360,
        "y": 460,
        "wires": [
            [
                "fn_dash_log"
            ],
            [],
            []
        ]
    },
    {
        "id": "fn_dash_log",
        "type": "function",
        "z": "tab_dash_upse",
        "name": "Convertir a tabla",
        "func": "const lineas = String(msg.payload).trim().split(/\\r?\\n/).filter(l => l);\nmsg.payload = lineas.map(l => {\n    const [hash, autor, cuando, ...mensaje] = l.split(\"~\");\n    return { hash, autor, cuando, mensaje: mensaje.join(\"~\") };\n});\nreturn msg;",
        "outputs": 1,
        "x": 560,
        "y": 460,
        "wires": [
            [
                "tpl_dash_commits"
            ]
        ]
    },
    {
        "id": "tpl_dash_commits",
        "type": "ui_template",
        "z": "tab_dash_upse",
        "group": "grp_dash_git",
        "name": "Tabla de commits",
        "order": 3,
        "width": 0,
        "height": 0,
        "format": "<div style=\"font-weight:bold;margin-bottom:6px\">Historial de commits (repositorio UPSE)</div>\n<table style=\"width:100%;border-collapse:collapse;font-size:13px\">\n  <tr style=\"text-align:left;border-bottom:1px solid #999\">\n    <th>Commit</th><th>Mensaje</th><th>Autor</th><th>Cuando</th>\n  </tr>\n  <tr ng-repeat=\"c in msg.payload\" style=\"border-bottom:1px solid #ddd\" ng-style=\"$first && {'background':'rgba(46,160,67,0.15)'}\">\n    <td><code>{{c.hash}}</code></td>\n    <td>{{c.mensaje}}</td>\n    <td>{{c.autor}}</td>\n    <td>{{c.cuando}}</td>\n  </tr>\n</table>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 770,
        "y": 460,
        "wires": [
            []
        ]
    },
    {
        "id": "exec_dash_status",
        "type": "exec",
        "z": "tab_dash_upse",
        "command": "git -C \"C:/Users/ALEX CORDOVA/.node-red/projects/ProyectosGIT\" status -sb",
        "addpay": "",
        "append": "",
        "useSpawn": "false",
        "timer": "10",
        "winHide": true,
        "oldrc": false,
        "name": "git status",
        "x": 370,
        "y": 520,
        "wires": [
            [
                "fn_dash_status"
            ],
            [],
            []
        ]
    },
    {
        "id": "fn_dash_status",
        "type": "function",
        "z": "tab_dash_upse",
        "name": "Estado de sincronizacion",
        "func": "const linea = String(msg.payload).split(/\\r?\\n/)[0] || \"\";\nconst rama = (linea.match(/^## ([^.\\s]+)/) || [])[1] || \"?\";\nconst ahead = +((linea.match(/ahead (\\d+)/) || [])[1] || 0);\nconst behind = +((linea.match(/behind (\\d+)/) || [])[1] || 0);\nconst cambios = String(msg.payload).split(/\\r?\\n/).slice(1).filter(l => l.trim()).length;\n\nlet texto;\nif (ahead > 0) {\n    texto = `<span style=\"color:#ff7f0e\">⬆ ${ahead} commit(s) pendientes de PUSH</span>`;\n} else if (behind > 0) {\n    texto = `<span style=\"color:#1f77b4\">⬇ ${behind} commit(s) pendientes de PULL</span>`;\n} else {\n    texto = `<span style=\"color:#2ca02c\">✔ Sincronizado con GitHub (origin/${rama})</span>`;\n}\nif (cambios > 0) {\n    texto += `<br><small>${cambios} archivo(s) modificados sin commit</small>`;\n}\nmsg.payload = texto;\nreturn msg;",
        "outputs": 1,
        "x": 580,
        "y": 520,
        "wires": [
            [
                "txt_dash_sync"
            ]
        ]
    },
